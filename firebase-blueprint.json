{
  "entities": {
    "Artwork": {
      "title": "Artwork",
      "description": "An artwork item in the private gallery collection.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for artwork" },
        "slug": { "type": "string", "description": "URL slug for artwork" },
        "title": { "type": "string", "description": "Title of artwork", "maxLength": 300 },
        "year": { "type": "string", "description": "Year created", "maxLength": 50 },
        "category": { "type": "string", "description": "Category or genre", "maxLength": 100 },
        "medium": { "type": "string", "description": "Medium used", "maxLength": 200 },
        "width": { "type": "number", "description": "Width in cm" },
        "height": { "type": "number", "description": "Height in cm" },
        "image": { "type": "string", "description": "Primary image URL", "maxLength": 2000 },
        "thumbnail": { "type": "string", "description": "Thumbnail image URL", "maxLength": 2000 },
        "description": { "type": "string", "description": "Detailed description", "maxLength": 5000 },
        "status": { "type": "string", "enum": ["published", "draft", "hidden"] },
        "featured": { "type": "boolean", "description": "Whether artwork is featured" },
        "order": { "type": "number", "description": "Display order in catalog" },
        "exhibitionOrder": { "type": "number", "description": "Display order in exhibition" },
        "createdAt": { "type": "string", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "description": "Update ISO timestamp" }
      },
      "required": ["id", "slug", "title", "image", "order"]
    },
    "Artist": {
      "title": "Artist",
      "description": "Profile information for the artist.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Artist name", "maxLength": 200 },
        "tagline": { "type": "string", "description": "Short tagline", "maxLength": 500 },
        "biography": { "type": "string", "description": "Artist biography", "maxLength": 5000 },
        "statement": { "type": "string", "description": "Artist statement", "maxLength": 5000 },
        "portrait": { "type": "string", "description": "Portrait image URL", "maxLength": 2000 },
        "yearsActive": { "type": "string", "description": "Years active string", "maxLength": 50 }
      },
      "required": ["name", "biography", "statement", "portrait"]
    },
    "CollectionInfo": {
      "title": "CollectionInfo",
      "description": "Metadata for the exhibition collection.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Collection title", "maxLength": 200 },
        "subtitle": { "type": "string", "description": "Collection subtitle", "maxLength": 500 },
        "quote": { "type": "string", "description": "Inspirational quote", "maxLength": 1000 },
        "description": { "type": "string", "description": "Collection description", "maxLength": 5000 },
        "giftDedication": { "type": "string", "description": "Gift dedication text", "maxLength": 2000 },
        "curatorNote": { "type": "string", "description": "Curatorial note", "maxLength": 2000 },
        "coverArtworkId": { "type": "string", "description": "ID of cover artwork", "maxLength": 100 }
      },
      "required": ["title", "subtitle", "description"]
    }
  },
  "firestore": {
    "/artworks/{artworkId}": {
      "schema": "Artwork",
      "description": "Collection of gallery artworks"
    },
    "/metadata/{docId}": {
      "schema": "Artist",
      "description": "Global metadata documents such as artist profile and collection info"
    }
  }
}
